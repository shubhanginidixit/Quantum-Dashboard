# ──────────────────────────────────────────────────
# Environment variables — copy to .env and fill in
# ──────────────────────────────────────────────────

# Google Cloud project (leave blank to use in-memory mock Firestore)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini / ADK model
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Risk-score threshold override (default 0.50)
RISK_THRESHOLD=0.50

# Firestore emulator (optional, set to use local emulator)
FIRESTORE_EMULATOR_HOST=
